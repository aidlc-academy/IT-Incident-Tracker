{
  "name": "incidentiq-backend",
  "version": "1.0.0",
  "description": "IncidentIQ backend \u2014 Lambda + DynamoDB",
  "main": "src/local/server.js",
  "scripts": {
    "start": "node src/local/server.js",
    "dev": "nodemon src/local/server.js",
    "test": "node --test tests/**/*.test.js tests/*.test.js",
    "lint": "echo 'No linter configured'",
    "db:start": "java -Djava.library.path=../tools/dynamodb-local/DynamoDBLocal_lib -jar ../tools/dynamodb-local/DynamoDBLocal.jar -sharedDb -port 8000 -dbPath ./data",
    "db:create-table": "node scripts/createTable.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
