# Backend environment variables
# Copy to .env and fill in values

# Local Express server port
PORT=3001

# Storage mode: 'dynamodb' | 'local'
STORAGE_MODE=local

# Path to local JSON data file (used when STORAGE_MODE=local)
DATA_FILE=./data/incidents.json

# AWS settings (required when STORAGE_MODE=dynamodb)
AWS_REGION=us-east-1
DYNAMODB_TABLE=incidentiq-incidents

# AWS credentials — supply via environment or ~/.aws/credentials, never hard-code here
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
