# Backend environment variables
# Copy to .env and adjust. Never commit the resulting .env — it is git-ignored.

# Local Express server port
PORT=3001

# Storage mode: 'dynamodb' | 'local'
# 'dynamodb' is what this project targets. 'local' falls back to a JSON file
# and needs neither Java nor DynamoDB.
STORAGE_MODE=dynamodb

# DynamoDB Local endpoint.
# REMOVE or leave empty when targeting real AWS, so the SDK resolves the
# regional endpoint and the IAM role credentials as normal.
DYNAMODB_ENDPOINT=http://localhost:8000

AWS_REGION=us-east-1
DYNAMODB_TABLE=incidentiq-incidents

# Placeholder credentials. The AWS SDK refuses to sign a request without
# credentials, and DynamoDB Local ignores their value. These are applied ONLY
# when DYNAMODB_ENDPOINT is set. On AWS, delete these lines and let the default
# credential chain (IAM role, ~/.aws/credentials) supply real ones.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Path to the JSON data file (used only when STORAGE_MODE=local)
DATA_FILE=./data/incidents.json
